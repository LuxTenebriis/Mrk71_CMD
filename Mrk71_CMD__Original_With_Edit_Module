        "## Functions related to calculating stats for stellar populations\n",
        "\n",
        "def poisson(val):\n",
        "    if val < 0:\n",
        "        return np.nan\n",
        "    return np.sqrt(val)\n",
        "\n",
        "def poisson_adivb(val1,val2):\n",
        "    # val1 = expectation value 1 or A (indep var)\n",
        "    # val2 = expectation value 2 or B (indep var)\n",
        "    # fcn = value of function calc'ed at A and B\n",
        "\n",
        "    err1 = poisson(val1)\n",
        "    err2 = poisson(val2)\n",
        "\n",
        "    fcn = np.abs(val1 / val2)\n",
        "\n",
        "    sigma = fcn * np.sqrt((err1/val1)**2 + (err2/val2)**2)\n",
        "\n",
        "    return sigma\n",
        "\n",
        "def get_star_groups(catalog, export_files = False, file_ext = '',path='',columns=['x','y'],ds9_offset=True, u_cutoff=23.):\n",
        "\n",
        "    # Original behavior: adds 1 to the first two selected coordinate columns.\n",
        "    # Retained for baseline reproduction; repeated calls shift coordinates again.\n",
        "    if ds9_offset:\n",
        "        for index in catalog.index:\n",
        "            catalog.loc[index,columns[0]] = catalog.loc[index,columns[0]] + 1\n",
        "            catalog.loc[index,columns[1]] = catalog.loc[index,columns[1]] + 1\n",
        "\n",
        "    ## RSG Groups ##\n",
        "    rsgs = catalog.loc[((catalog['F438W']-catalog['F547M']) >= 1.0) &\n",
        "        (catalog['F547M'] <= 24.)][columns]\n",
        "    rsgs_ubright = catalog.loc[((catalog['F438W']-catalog['F547M']) >= 1.0) &\n",
        "        (catalog['F547M'] <= 24.) & (catalog['F336W'] <= u_cutoff)][columns]\n",
        "    rsgs_ufaint = catalog.loc[((catalog['F438W']-catalog['F547M']) >= 1.0) &\n",
        "        (catalog['F547M'] <= 24.) & (catalog['F336W'] > u_cutoff)][columns]\n",
        "    rsgs_nou = catalog.loc[((catalog['F438W']-catalog['F547M']) >= 1.0) &\n",
        "        (catalog['F547M'] <= 24.) & (catalog['F336W'].isna())][columns]\n",
        "\n",
        "    ## Y/R Groups ##\n",
        "    yr = catalog.loc[((catalog['F547M']-catalog['F814W']) >= 0.25)][columns]\n",
        "    yr_ufaint = catalog.loc[((catalog['F547M']-catalog['F814W']) >= 0.25) &\n",
        "        (catalog['F336W'] > u_cutoff)][columns]\n",
        "    yr_ubright = catalog.loc[((catalog['F547M']-catalog['F814W']) >= 0.25) &\n",
        "        (catalog['F336W'] <= u_cutoff)][columns]\n",
        "    yr_nou = catalog.loc[((catalog['F547M']-catalog['F814W']) >= 0.25) &\n",
        "        (catalog['F336W'].isna())][columns]\n",
        "    yr_nou_fuv = catalog.loc[((catalog['F547M']-catalog['F814W']) >= 0.25) &\n",
        "        (catalog['F336W'].isna())\n",
        "        & (~catalog['F150LP'].isna() | ~catalog['F165LP'].isna())][columns]\n",
        "\n",
        "    ## MS Groups ##\n",
        "    ms = catalog.loc[~(catalog.index.isin(rsgs.index) |\n",
        "                       catalog.index.isin(yr.index))][columns]\n",
        "    ms_ubright = catalog.loc[(catalog['F336W'] <= u_cutoff) &\n",
        "        ~(catalog.index.isin(rsgs.index) | catalog.index.isin(yr.index))][columns]\n",
        "    ms_ufaint = catalog.loc[(catalog['F336W'] > u_cutoff) &\n",
        "        ~(catalog.index.isin(rsgs.index) | catalog.index.isin(yr.index))][columns]\n",
        "\n",
        "    ## Export to files ##\n",
        "    if path == '':\n",
        "        path = os.getcwd()\n",
        "\n",
        "    if export_files:\n",
        "        if path != os.getcwd():\n",
        "            os.chdir(path)\n",
        "\n",
        "        rsgs.to_csv(f'{file_ext}_RSG.txt',index=False,sep=' ')\n",
        "        rsgs_ubright.to_csv(f'{file_ext}_UBriRSG.txt',index=False,sep=' ')\n",
        "        rsgs_ufaint.to_csv(f'{file_ext}_UFntRSG.txt',index=False,sep=' ')\n",
        "        rsgs_nou.to_csv(f'{file_ext}_NoURSG.txt',index=False,sep=' ')\n",
        "\n",
        "        yr.to_csv(f'{file_ext}_YR.txt',index=False,sep=' ')\n",
        "        yr_ubright.to_csv(f'{file_ext}_UBriYR.txt',index=False,sep=' ')\n",
        "        yr_ufaint.to_csv(f'{file_ext}_UFntYR.txt',index=False,sep=' ')\n",
        "        yr_nou.to_csv(f'{file_ext}_NoUYR.txt',index=False,sep=' ')\n",
        "        yr_nou_fuv.to_csv(f'{file_ext}_NoUwithFUV_YR.txt',index=False,sep=' ')\n",
        "\n",
        "        ms.to_csv(f'{file_ext}_MS.txt',index=False,sep=' ')\n",
        "        ms_ubright.to_csv(f'{file_ext}_UBriMS.txt',index=False,sep=' ')\n",
        "        ms_ufaint.to_csv(f'{file_ext}_UFntMS.txt',index=False,sep=' ')\n",
        "\n",
        "\n",
        "    return [[rsgs,rsgs_ubright,rsgs_ufaint,rsgs_nou],\n",
        "            [yr,yr_ufaint,yr_ubright,yr_nou,yr_nou_fuv],\n",
        "            [ms,ms_ubright,ms_ufaint]]\n",
        "\n",
        "def set_star_groups(catalog, custom_groups):\n",
        "    # \"Groups\" should be an array matching the output of get star groups:\n",
        "    # [\n",
        "    #     [rsgs, rsgs_ubright, rsgs_ufaint, rsgs_nou],\n",
        "    #     [yr, yr_ufaint, yr_ubright, yr_nou, yr_nou_fuv],\n",
        "    #     [ms, ms_ubright, ms_ufaint]\n",
        "    # ]\n",
        "\n",
        "    [[rsgs,rsgs_ubright,rsgs_ufaint,rsgs_nou],\n",
        "     [yr,yr_ufaint,yr_ubright,yr_nou,yr_nou_fuv],\n",
        "     [ms,ms_ubright,ms_ufaint]] = custom_groups\n",
        "\n",
        "    for index in catalog.index:\n",
        "        if index in rsgs.index:\n",
        "            catalog.loc[index, 'Group'] = 'RSG'\n",
        "\n",
        "            if index in rsgs_ubright.index:\n",
        "                catalog.loc[index, 'Label'] = 'RSG, U < 23'\n",
        "            elif index in rsgs_ufaint.index:\n",
        "                catalog.loc[index, 'Label'] = 'RSG, U > 23'\n",
        "            elif index in rsgs_nou.index:\n",
        "                catalog.loc[index, 'Label'] = 'RSG, no U'\n",
        "            else:\n",
        "                catalog.loc[index, 'Label'] = 'RSG'\n",
        "                print(f'Unlabeled RSG at index {index}')\n",
        "\n",
        "        elif index in yr.index:\n",
        "            catalog.loc[index, 'Group'] = 'Y/R'\n",
        "\n",
        "            if index in yr_ubright.index:\n",
        "                catalog.loc[index, 'Label'] = 'Y/R, U < 23'\n",
        "            elif index in yr_ufaint.index:\n",
        "                catalog.loc[index, 'Label'] = 'Y/R, U > 23'\n",
        "            elif index in yr_nou.index:\n",
        "                catalog.loc[index, 'Label'] = 'Y/R, no U'\n",
        "            elif index in yr_nou_fuv.index:\n",
        "                catalog.loc[index, 'Label'] = 'Y/R, no U with FUV'\n",
        "                print(f'No U with FUV Y/R at index {index}')\n",
        "            else:\n",
        "                catalog.loc[index, 'Label'] = 'Y/R'\n",
        "                print(f'Unlabeled Y/R at index {index}')\n",
        "\n",
        "        elif index in ms.index:\n",
        "            catalog.loc[index, 'Group'] = 'MS'\n",
        "\n",
        "            if index in ms_ubright.index:\n",
        "                catalog.loc[index, 'Label'] = 'MS, U < 23'\n",
        "            elif index in ms_ufaint.index:\n",
        "                catalog.loc[index, 'Label'] = 'MS, U > 23'\n",
        "            else:\n",
        "                catalog.loc[index, 'Label'] = 'MS'\n",
        "\n",
        "        else:\n",
        "            print(f'Star not in Y/R or MS at index {index}')\n",
        "\n",
        "    return catalog\n",
        "\n",
        "# Basic stats, returns dict\n",
        "def get_stellar_pop_stats_new(catalog,corr_fac=1):\n",
        "    [[rsgs,rsgs_ubright,rsgs_ufaint,rsgs_nou],\n",
        "     [yr,yr_ufaint,yr_ubright,yr_nou,yr_nou_fuv],\n",
        "     [ms,ms_ubright,ms_ufaint]] = get_star_groups(catalog, export_files = False)\n",
        "\n",
        "    vals = {'Total' : int(len(catalog))*corr_fac,\n",
        "\n",
        "            'MS' : (len(catalog) - len(yr))*corr_fac,\n",
        "            'MS, U < 23' : len(ms_ubright)*corr_fac,\n",
        "\n",
        "            'All RSG': len(rsgs)*corr_fac,\n",
        "            'RSG, U < 23' : len(rsgs_ubright)*corr_fac,\n",
        "            'RSG, U > 23' : len(rsgs_ufaint)*corr_fac,\n",
        "            'RSG, no U' : len(rsgs_nou)*corr_fac,\n",
        "\n",
        "            'All Y/R' : len(yr)*corr_fac,\n",
        "            'Y/R, U < 23' : len(yr_ubright)*corr_fac,\n",
        "            'Y/R, U > 23' : len(yr_ufaint)*corr_fac,\n",
        "            'Y/R, no U' : len(yr_nou)*corr_fac,\n",
        "            'Y/R, no U, with FUV' : len(yr_nou_fuv)*corr_fac,\n",
        "\n",
        "            'MS (% of total)' : round((len(catalog) - len(yr)) / len(catalog) * 100,2),\n",
        "\n",
        "            'All RSG (% of total)' : round(len(rsgs) / len(catalog) * 100,2),\n",
        "            'RSG, U < 23 (% of total)' : round(len(rsgs_ubright) / len(catalog) * 100,2),\n",
        "            'RSG, U > 23 (% of total)' : round(len(rsgs_ufaint) / len(catalog) * 100,2),\n",
        "            'RSG, no U (% of total)' : round(len(rsgs_nou) / len(catalog) * 100,2),\n",
        "\n",
        "            'All Y/R (% of total)' : round(len(yr) / len(catalog) * 100,2),\n",
        "            'Y/R, U < 23 (% of total)' : round(len(yr_ubright) / len(catalog) * 100,2),\n",
        "            'Y/R, U > 23 (% of total)' : round(len(yr_ufaint) / len(catalog) * 100,2),\n",
        "            'Y/R, no U (% of total)' : round(len(yr_nou) / len(catalog) * 100,2),\n",
        "            'Y/R, no U, with FUV (% of total)' : round(len(yr_nou_fuv) / len(catalog) * 100,2)\n",
        "           }\n",
        "\n",
        "    return vals\n",
        "\n",
        "# Errors for stats\n",
        "def get_stellar_pop_stats_errs_new(catalog,corr_fac=1):\n",
        "    stats_dict = get_stellar_pop_stats_new(catalog,1)\n",
        "    round_dec = 1\n",
        "    errs = dict()\n",
        "    total_stars = stats_dict['Total']\n",
        "\n",
        "    for row, (key, val) in enumerate(stats_dict.items()):\n",
        "        if row < 12:\n",
        "            errs[key] = round(poisson(val)*corr_fac,round_dec)\n",
        "        else:\n",
        "            errs[key] = round(poisson_adivb(val,total_stars)*100,round_dec)\n",
        "\n",
        "    return errs\n",
        "\n",
        "# Make stats into a pandas series (column)\n",
        "def get_stellar_pop_column_new(catalog,name='col',corr_fac=1):\n",
        "    vals = get_stellar_pop_stats_new(catalog,corr_fac)\n",
        "    column = pd.Series(vals,name=name)\n",
        "    return column\n",
        "\n",
        "# Make stats errors into pandas series (column)\n",
        "def get_stellar_pop_err_column_new(catalog,name='err_col',corr_fac=1):\n",
        "    errs = get_stellar_pop_stats_errs_new(catalog,corr_fac)\n",
        "    column = pd.Series(errs,name=name)\n",
        "    return column\n",
        "\n",
        "# Combine stats with errors into pandas series using +/- notation\n",
        "def get_stellar_pops_witherrs_column_new(catalog,name='Region',corr_fac=1):\n",
        "    vals_col = get_stellar_pop_column_new(catalog,name=name,corr_fac=corr_fac)\n",
        "    errs_col = get_stellar_pop_err_column_new(catalog,name=name,corr_fac=corr_fac)\n",
        "\n",
        "    ufloats = [ufloat(value,errs_col.iloc[ix]) for ix, value in enumerate(vals_col)]\n",
        "    uarr = UncertaintyArray(ufloats)\n",
        "\n",
        "    column = pd.Series(uarr,name=name,index=vals_col.index)\n",
        "\n",
        "    return column\n",
        "\n",
        "# Make entire table of stats for all 3 regions and include area correction factors given by Sally\n",
        "def get_all_stellar_pop_stats_witherrs_new(catalogs,names=['KnotA','KnotB','RegII'],mode='newcol',factors=[]):\n",
        "    cols = []\n",
        "    if factors == []:\n",
        "        knota_fac = [1.047,1.522,1,1] # [factor for <50px, factor for 50-125px, factor for >125px, factor for total]\n",
