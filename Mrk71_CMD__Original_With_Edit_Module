        "def plot_tlusty_isos_ccd_optical_dash(\n",
        "    fig,\n",
        "    isos,\n",
        "    ages,\n",
        "    colors,\n",
        "    legend_title=''\n",
        "):\n",
        "    if not (len(isos) == len(ages) == len(colors)):\n",
        "        raise ValueError(\"isos, ages, and colors must have equal lengths.\")\n",
        "\n",
        "    for age, iso, color in zip(ages, isos, colors):\n",
        "        x = iso['V_vega'] - iso['I_vega']\n",
        "\n",
        "        y_colors = [\n",
        "            iso['U_vega'] - iso['B_vega'],\n",
        "            iso['B_vega'] - iso['V_vega']\n",
        "        ]\n",
        "\n",
        "        for row in [1, 2, 3]:\n",
        "            for col, y in enumerate(y_colors, start=1):\n",
        "                fig.add_trace(\n",
        "                    go.Scatter(\n",
        "                        x=x,\n",
        "                        y=y,\n",
        "                        name=f'{age} Myr',\n",
        "                        mode='lines',\n",
        "                        legendgroup=str(age),\n",
        "                        line=dict(width=2, color=color),\n",
        "                        showlegend=(row == 1 and col == 1)\n",
        "                    ),\n",
        "                    row=row,\n",
        "                    col=col\n",
        "                )\n",
        "\n",
        "    fig.update_layout(\n",
        "        legend=dict(title=dict(text=legend_title))\n",
        "    )\n",
        "\n",
        "    return fig"
      ],
