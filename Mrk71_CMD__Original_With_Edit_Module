        "\n",
        "for ix, plotcatalog in enumerate(plotcatalogs):\n",
        "    region_name = regions[ix]\n",
        "    row_num = ix + 1\n",
        "\n",
        "    # Make text box that shows up when you hover over a star\n",
        "    if ix > 2:\n",
