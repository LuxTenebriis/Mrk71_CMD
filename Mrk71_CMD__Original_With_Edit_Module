        "## Isochrone plotting functions\n",
        "def plot_tlusty_isos_cmd_fuv_dash(fig, isos=None, ages = ['4','6','10','20','40','50','100'],\n",
        "                                      colors = ['blue', 'magenta', 'green','goldenrod','purple',\n",
        "                                                'orange','teal']):\n",
        "    if isos==None:\n",
        "        isos = load_tlusty_isos(ages)\n",
        "\n",
        "    for row_num in [1,2,3]:\n",
        "        for ii, isochrone in enumerate(isos):\n",
        "            fig.add_trace(go.Scatter(x=isochrone['FUV150_vega']-isochrone['FUV165_vega'],\n",
        "                                     y=isochrone['FUV165_vega'],\n",
        "                                     name=f\"{ages[ii]} Myr\",\n",
        "                                     mode='lines', legendgroup=str(ages[ii]),\n",
        "                                     line=dict(width=2, color=colors[ii]),\n",
        "                                     showlegend=(row_num==1)\n",
        "                                     ), row=row_num, col=1)\n",
        "\n",
        "            fig.add_trace(go.Scatter(x=isochrone['FUV150_vega']-isochrone['U_vega'],\n",
        "                                     y=isochrone['U_vega'],\n",
        "                                     name=f\"{ages[ii]} Myr\",\n",
        "                                     mode='lines', legendgroup=str(ages[ii]),\n",
        "                                     line=dict(width=2, color=colors[ii]),\n",
        "                                     showlegend=False\n",
        "                                     ), row=row_num, col=2)\n",
        "\n",
        "            fig.add_trace(go.Scatter(x=isochrone['FUV165_vega']-isochrone['U_vega'],\n",
        "                                     y=isochrone['U_vega'],\n",
        "                                     name=f\"{ages[ii]} Myr\",\n",
        "                                     mode='lines', legendgroup=str(ages[ii]),\n",
        "                                     line=dict(width=2, color=colors[ii]),\n",
        "                                     showlegend=False\n",
        "                                     ), row=row_num, col=3)\n",
        "    fig.update_layout(legend=dict(title=dict(text = \"\")))\n",
        "\n",
        "    return fig\n",
        "\n",
        "def plot_tlusty_isos_cmd_fuvopt_dash(fig, ages = ['4','6','10','20','40','50','100'],\n",
        "                                      colors = ['blue', 'magenta', 'green','goldenrod','purple',\n",
        "                                                'orange','teal']):\n",
        "    isos = load_tlusty_isos(ages)\n",
        "\n",
        "    for row_num in [1,2,3]:\n",
        "        for ii, isochrone in enumerate(isos):\n",
        "            fig.add_trace(go.Scatter(x=isochrone['FUV150_vega']-isochrone['U_vega'],\n",
        "                                     y=isochrone['FUV150_vega'],\n",
        "                                     name=f\"{ages[ii]} Myr\",\n",
        "                                     mode='lines', legendgroup=str(ages[ii]),\n",
        "                                     line=dict(width=2, color=colors[ii]),\n",
        "                                     showlegend=(row_num==1)\n",
        "                                     ), row=row_num, col=1)\n",
        "\n",
        "            fig.add_trace(go.Scatter(x=isochrone['FUV150_vega']-isochrone['U_vega'],\n",
        "                                     y=isochrone['V_vega'],\n",
        "                                     name=f\"{ages[ii]} Myr\",\n",
        "                                     mode='lines', legendgroup=str(ages[ii]),\n",
        "                                     line=dict(width=2, color=colors[ii]),\n",
        "                                     showlegend=False\n",
        "                                     ), row=row_num, col=2)\n",
        "\n",
        "            fig.add_trace(go.Scatter(x=isochrone['FUV150_vega']-isochrone['B_vega'],\n",
        "                                     y=isochrone['I_vega'],\n",
        "                                     name=f\"{ages[ii]} Myr\",\n",
        "                                     mode='lines', legendgroup=str(ages[ii]),\n",
        "                                     line=dict(width=2, color=colors[ii]),\n",
        "                                     showlegend=False\n",
        "                                     ), row=row_num, col=3)\n",
        "    fig.update_layout(legend=dict(title=dict(text = \"\")))\n",
        "\n",
        "    return fig\n"
      ]
    },
