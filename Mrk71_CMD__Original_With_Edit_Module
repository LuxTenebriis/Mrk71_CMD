      "source": [
        "# Define sample\n",
        "err_thres = 0.5 # Maximum allowable error in mags\n",
        "xy_pix_tolerance = 1. # PSF fitted coords must be within 1 pix of each other to be same star\n",
        "\n",
        "fuv_cutoff = 22. # Mag cutoff for FUV bands (F150LP and F165LP)\n",
        "v_cutoff = 25. # Mag cutoff for V band (F547M)\n",
        "\n",
        "b_completeness = 24.5 # Sample selection cutoff for B band (F438W)\n",
        "i_completeness = 25. # Sample selection cutoff for I band (F814W)\n",
        "\n",
        "# Sample selection based on B and I bands\n",
        "knota_catalog_filtered = knota_catalog.loc[(knota_catalog['F438W'] <= b_completeness) | (knota_catalog['F814W'] <= i_completeness)].copy()\n",
        "knotb_catalog_filtered = knotb_catalog.loc[(knotb_catalog['F438W'] <= b_completeness) | (knotb_catalog['F814W'] <= i_completeness)].copy()\n",
        "regii_catalog_filtered = regii_catalog.loc[(regii_catalog['F438W'] <= b_completeness) | (regii_catalog['F814W'] <= i_completeness)].copy()\n",
        "\n",
        "# Filter based on other criteria (errors, other band cutoffs, etc.)\n",
        "for catalogx in [knota_catalog_filtered,knotb_catalog_filtered,regii_catalog_filtered]:\n",
        "    for index in catalogx.index:\n",
        "        ## Filter out stars with coordinates too far off\n",
        "        if ((np.abs(catalogx.loc[index, 'x'] - catalogx.loc[index, 'F150LP_x_fit']) >= xy_pix_tolerance) |\n",
        "            (np.abs(catalogx.loc[index, 'y'] - catalogx.loc[index, 'F150LP_y_fit']) >= xy_pix_tolerance)):\n",
        "            catalogx.loc[index, 'F150LP'] = np.nan\n",
        "            catalogx.loc[index, 'F150LP_mags_err'] = np.nan\n",
        "            catalogx.loc[index, 'F150LP_x_fit'] = np.nan\n",
        "            catalogx.loc[index, 'F150LP_y_fit'] = np.nan\n",
        "\n",
        "        if ((np.abs(catalogx.loc[index, 'x'] - catalogx.loc[index, 'F165LP_x_fit']) >= xy_pix_tolerance) |\n",
        "            (np.abs(catalogx.loc[index, 'y'] - catalogx.loc[index, 'F165LP_y_fit']) >= xy_pix_tolerance)):\n",
        "            catalogx.loc[index, 'F165LP'] = np.nan\n",
        "            catalogx.loc[index, 'F165LP_mags_err'] = np.nan\n",
        "            catalogx.loc[index, 'F165LP_x_fit'] = np.nan\n",
        "            catalogx.loc[index, 'F165LP_y_fit'] = np.nan\n",
        "\n",
        "        if ((np.abs(catalogx.loc[index, 'x'] - catalogx.loc[index, 'F336W_x_fit']) >= xy_pix_tolerance) |\n",
        "            (np.abs(catalogx.loc[index, 'y'] - catalogx.loc[index, 'F336W_y_fit']) >= xy_pix_tolerance)):\n",
        "            catalogx.loc[index, 'F336W'] = np.nan\n",
        "            catalogx.loc[index, 'F336W_mags_err'] = np.nan\n",
        "            catalogx.loc[index, 'F336W_x_fit'] = np.nan\n",
        "            catalogx.loc[index, 'F336W_y_fit'] = np.nan\n",
        "\n",
        "        if ((np.abs(catalogx.loc[index, 'x'] - catalogx.loc[index, 'F438W_x_fit']) >= xy_pix_tolerance) |\n",
        "            (np.abs(catalogx.loc[index, 'y'] - catalogx.loc[index, 'F438W_y_fit']) >= xy_pix_tolerance)):\n",
        "            catalogx.loc[index, 'F438W'] = np.nan\n",
        "            catalogx.loc[index, 'F438W'] = np.nan\n",
        "            catalogx.loc[index, 'F438W_mags_err'] = np.nan\n",
        "            catalogx.loc[index, 'F438W_x_fit'] = np.nan\n",
        "            catalogx.loc[index, 'F438W_y_fit'] = np.nan\n",
        "\n",
        "        if ((np.abs(catalogx.loc[index, 'x'] - catalogx.loc[index, 'F547M_x_fit']) >= xy_pix_tolerance) |\n",
        "            (np.abs(catalogx.loc[index, 'y'] - catalogx.loc[index, 'F547M_y_fit']) >= xy_pix_tolerance)):\n",
        "            catalogx.loc[index, 'F547M'] = np.nan\n",
        "            catalogx.loc[index, 'F547M_mags_err'] = np.nan\n",
        "            catalogx.loc[index, 'F547M_x_fit'] = np.nan\n",
        "            catalogx.loc[index, 'F547M_y_fit'] = np.nan\n",
        "\n",
        "        if ((np.abs(catalogx.loc[index, 'x'] - catalogx.loc[index, 'F814W_x_fit']) >= xy_pix_tolerance) |\n",
        "            (np.abs(catalogx.loc[index, 'y'] - catalogx.loc[index, 'F814W_y_fit']) >= xy_pix_tolerance)):\n",
        "            catalogx.loc[index, 'F814W'] = np.nan\n",
        "            catalogx.loc[index, 'F814W'] = np.nan\n",
        "            catalogx.loc[index, 'F814W_mags_err'] = np.nan\n",
        "            catalogx.loc[index, 'F814W_x_fit'] = np.nan\n",
        "            catalogx.loc[index, 'F814W_y_fit'] = np.nan\n",
        "\n",
        "        ## Filter out stars with errors above 0.5 magnitudes\n",
        "        if ((catalogx.loc[index, 'F150LP_mags_err'] >= err_thres) |\n",
        "            (catalogx.loc[index, 'F150LP_flags'] != 0) |\n",
        "            (catalogx.loc[index, 'F150LP'] >= fuv_cutoff)):\n",
        "\n",
        "            catalogx.loc[index, 'F150LP'] = np.nan\n",
        "            catalogx.loc[index, 'F150LP_mags_err'] = np.nan\n",
        "            catalogx.loc[index, 'F150LP_x_fit'] = np.nan\n",
        "            catalogx.loc[index, 'F150LP_y_fit'] = np.nan\n",
        "\n",
        "        if ((catalogx.loc[index, 'F165LP_mags_err'] >= err_thres) |\n",
        "            (catalogx.loc[index, 'F165LP_flags'] != 0) |\n",
        "            (catalogx.loc[index, 'F165LP'] >= fuv_cutoff)):\n",
        "\n",
        "            catalogx.loc[index, 'F165LP'] = np.nan\n",
        "            catalogx.loc[index, 'F165LP_mags_err'] = np.nan\n",
        "            catalogx.loc[index, 'F165LP_x_fit'] = np.nan\n",
        "            catalogx.loc[index, 'F165LP_y_fit'] = np.nan\n",
        "\n",
        "        if ((catalogx.loc[index, 'F336W_mags_err'] >= err_thres) |\n",
        "            (catalogx.loc[index, 'F336W_flags'] != 0)):\n",
        "\n",
        "            catalogx.loc[index, 'F336W'] = np.nan\n",
        "            catalogx.loc[index, 'F336W_mags_err'] = np.nan\n",
        "            catalogx.loc[index, 'F336W_x_fit'] = np.nan\n",
        "            catalogx.loc[index, 'F336W_y_fit'] = np.nan\n",
        "\n",
        "        if ((catalogx.loc[index, 'F438W_mags_err'] >= err_thres) |\n",
        "            (catalogx.loc[index, 'F438W_flags'] != 0)):\n",
        "\n",
        "            catalogx.loc[index, 'F438W'] = np.nan\n",
        "            catalogx.loc[index, 'F438W_mags_err'] = np.nan\n",
        "            catalogx.loc[index, 'F438W_x_fit'] = np.nan\n",
        "            catalogx.loc[index, 'F438W_y_fit'] = np.nan\n",
        "\n",
        "        if ((catalogx.loc[index, 'F547M_mags_err'] >= err_thres) |\n",
        "            (catalogx.loc[index, 'F547M_flags'] != 0) |\n",
        "            (catalogx.loc[index, 'F547M'] >= v_cutoff)):\n",
        "\n",
        "            catalogx.loc[index, 'F547M'] = np.nan\n",
        "            catalogx.loc[index, 'F547M_mags_err'] = np.nan\n",
        "            catalogx.loc[index, 'F547M_x_fit'] = np.nan\n",
        "            catalogx.loc[index, 'F547M_y_fit'] = np.nan\n",
        "\n",
        "        if ((catalogx.loc[index, 'F814W_mags_err'] >= err_thres) |\n",
        "            (catalogx.loc[index, 'F814W_flags'] != 0)):\n",
        "\n",
        "            catalogx.loc[index, 'F814W'] = np.nan\n",
        "            catalogx.loc[index, 'F814W_mags_err'] = np.nan\n",
        "            catalogx.loc[index, 'F814W_x_fit'] = np.nan\n",
        "            catalogx.loc[index, 'F814W_y_fit'] = np.nan\n",
        "\n",
        "\n",
        "    df_x = catalogx[['F150LP_x_fit','F165LP_x_fit','F336W_x_fit','F438W_x_fit','F547M_x_fit','F814W_x_fit']]\n",
        "    df_y = catalogx[['F150LP_y_fit','F165LP_y_fit','F336W_y_fit','F438W_y_fit','F547M_y_fit','F814W_y_fit']]\n",
        "\n",
        "    # Define average star coord from PSF fitted coords in each band\n",
        "    catalogx['x_fit_avg'] = df_x.mean(axis=1)\n",
        "    catalogx['y_fit_avg'] = df_y.mean(axis=1)\n",
        "\n",
        "    # Define median star coord from PSF fitted coords in each band\n",
        "    catalogx['x_fit_med'] = df_x.median(axis=1)\n",
        "    catalogx['y_fit_med'] = df_y.median(axis=1)\n",
        "\n",
        "    # catalogx = catalogx.dropna(thresh=2,subset=bands)\n",
        "\n",
        "display(knota_catalog_filtered)\n",
        "display(knotb_catalog_filtered)\n",
        "display(regii_catalog_filtered)"
      ]
