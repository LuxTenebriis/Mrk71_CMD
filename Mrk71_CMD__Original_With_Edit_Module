        "# Replace missing photometry in filtered catalogs with aperture photometry\n",
        "all_apstars = [knota_apstars,knotb_apstars,regii_apstars]\n",
        "all_catalogs = [knota_catalog_filtered,knotb_catalog_filtered,\n",
        "                regii_catalog_filtered]\n",
        "\n",
        "for ix, apstars in enumerate(all_apstars):\n",
        "    catalogx = all_catalogs[ix]\n",
        "    shared_index = catalogx.index.intersection(apstars.index)\n",
        "\n",
        "    col_map = {\n",
