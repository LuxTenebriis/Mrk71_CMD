        "        factors = [knota_fac,knotb_fac,regii_fac]\n",
        "\n",
        "    # Older version where I separated stats and errs in diff cols\n",
        "    if mode == 'newcol':\n",
        "        for ix, catalog in enumerate(catalogs):\n",
        "            cols.append(get_stellar_pop_column_new(catalog,name=names[ix]))\n",
        "        for ix, catalog in enumerate(catalogs):\n",
        "            cols.append(get_stellar_pop_err_column_new(catalog,name=f'{names[ix]}_Err'))\n",
        "\n",
        "    # The mode I actually used for final numbers. Use caution with Total/All column because of corr factors\n",
        "    elif mode == 'radial':\n",
        "        for ix, catalog in enumerate(catalogs):\n",
        "            groups = [catalog.loc[catalog['distance']<50.],\n",
        "                  catalog.loc[(catalog['distance']>=50.) &\n",
        "                      (catalog['distance']<=125.)],\n",
        "                  catalog.loc[catalog['distance']>125.],\n",
        "                  catalog]\n",
        "            col_names = ['< 50 px','50 - 125 px','> 125 px','All']\n",
        "            for iy, group in enumerate(groups):\n",
        "                factor = factors[ix][iy]\n",
        "                cols.append(get_stellar_pops_witherrs_column_new(group,name=f'{names[ix]} {col_names[iy]}',corr_fac=factor))\n",
        "\n",
        "    else:\n",
        "        for ix, catalog in enumerate(catalogs):\n",
        "            cols.append(get_stellar_pops_witherrs_column_new(catalog,name=names[ix]))\n",
        "\n",
        "    df = pd.concat(cols, axis=1)\n",
        "\n",
        "    return df"
