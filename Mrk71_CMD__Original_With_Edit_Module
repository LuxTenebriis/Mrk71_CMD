        "# Functions related to substituting apphot for PSF phot\n",
        "# Helpers for matching edit-list coordinates and moving stars between groups.\n",
        "# These functions do not replace photometric measurements.\n",
        "\n",
        "from scipy.spatial import cKDTree\n",
        "\n",
        "def match_by_position(group_df, edit_df, tol=1.0,cols=['x','y']):\n",
        "    \"\"\"\n",
        "    Match stars in edit_df to stars in group_df using x/y position.\n",
        "\n",
        "    Parameters\n",
        "    ----------\n",
        "    group_df : pandas.DataFrame\n",
        "        Original stellar group with all columns.\n",
        "    edit_df : pandas.DataFrame\n",
        "        IRAF-edited file containing only x_fit_med and y_fit_med.\n",
        "    tol : float\n",
        "        Maximum allowed separation (pixels).\n",
        "\n",
        "    Returns\n",
        "    -------\n",
        "    matched_rows : pandas.DataFrame\n",
        "        Rows from group_df corresponding to edit_df.\n",
        "    distances : ndarray\n",
        "        Matching distances.\n",
        "    \"\"\"\n",
        "\n",
        "    tree = cKDTree(group_df[cols].values)\n",
        "\n",
        "    dist, ind = tree.query(\n",
        "        edit_df[cols].values,\n",
        "        distance_upper_bound=tol\n",
        "    )\n",
        "\n",
        "    good = np.isfinite(dist)\n",
        "\n",
        "    if np.sum(~good):\n",
        "        print(f\"{np.sum(~good)} stars were not matched within {tol} pixels.\")\n",
        "\n",
        "    matched = group_df.iloc[ind[good]].copy()\n",
        "    matched[\"match_dist\"] = dist[good]\n",
        "\n",
        "    return matched, dist\n",
        "\n",
        "def move_rows(source_df, dest_df, rows_to_move):\n",
        "    \"\"\"\n",
        "    Move rows from one dataframe to another using the dataframe index.\n",
        "    \"\"\"\n",
        "\n",
        "    source_new = source_df.drop(rows_to_move.index)\n",
        "\n",
        "    dest_new = pd.concat(\n",
        "        [dest_df, rows_to_move.drop(columns=\"match_dist\", errors=\"ignore\")],\n",
        "        ignore_index=False\n",
        "    )\n",
        "\n",
        "    return source_new, dest_new\n",
        "\n",
        "def check_duplicate_matches(matched):\n",
        "    dup = matched.index.duplicated(keep=False)\n",
        "\n",
        "    if dup.any():\n",
        "        print(\"Duplicate matches found:\")\n",
        "        print(matched.loc[dup][[\"x_fit_med\",\"y_fit_med\",\"match_dist\"]])"
      ]
    },
