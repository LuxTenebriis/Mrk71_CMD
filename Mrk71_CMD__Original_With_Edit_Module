      "source": [
        "# Knot A Optical CMDs\n",
        "# regions = ['Knot A','Knot B','Reg II']*2\n",
        "# plotcatalogs = [knota_catalog,knotb_catalog,regii_catalog,\n",
        "#                 knota_catalog_filtered,knotb_catalog_filtered,regii_catalog_filtered]\n",
        "\n",
        "\n",
        "radial_catalog = knota_catalog\n",
        "radial_catalog2 = knota_catalog_filtered\n",
        "regions = ['Knot A (<50 px)','Knot A (50-125 px)','Knot A (>125 px)'] * 2\n",
        "\n",
        "\n",
        "plotcatalogs1 = [radial_catalog.loc[radial_catalog['distance']<50.],\n",
        "                radial_catalog.loc[(radial_catalog['distance']>50.) &\n",
        "                    (radial_catalog['distance']<125.)],\n",
        "                radial_catalog.loc[radial_catalog['distance']>125.]]\n",
        "\n",
        "plotcatalogs2 = [radial_catalog2.loc[radial_catalog2['distance']<50.],\n",
        "                radial_catalog2.loc[(radial_catalog2['distance']>50.) &\n",
        "                    (radial_catalog2['distance']<125.)],\n",
        "                radial_catalog2.loc[radial_catalog2['distance']>125.]]\n",
        "\n",
        "plotcatalogs = plotcatalogs1 + plotcatalogs2\n",
        "\n",
        "fig = make_subplots(rows=3, cols=3,\n",
        "                    subplot_titles=('',f'{regions[0]}','',\n",
        "                                    '',f'{regions[1]}','',\n",
        "                                    '',f'{regions[2]}',''),\n",
        "                    horizontal_spacing=0.1,vertical_spacing=0.1\n",
        "                   )\n",
        "\n",
        "\n",
        "# plot_bpass = True\n",
        "# bpass_age = 8.0\n",
        "# plot_title = f\"{region} with BPASS {round(10**bpass_age /10**6,0)} Myr\" # Tlusty-Indo\" # BaSeL\"#\n",
        "\n",
        "\n",
        "## T Indo or Basel##\n",
        "#!!!!fig = plot_tlusty_isos_cmd_optical_dash(fig, ages=['4','6','10','20','100'],legend_title='')\n",
        "fig = plot_tlusty_isos_cmd_optical_dash(\n",
        "    fig,\n",
        "    isos=isos,\n",
        "    ages=ages,\n",
        "    colors=['blue','magenta','green','goldenrod','purple'],\n",
        "    legend_title=''\n",
        ")\n",
        "\n",
        "for ix, plotcatalog in enumerate(plotcatalogs):\n",
        "    region_name = regions[ix]\n",
        "    row_num = ix + 1\n",
        "\n",
        "    if ix > 2:\n",
        "        hover_text = [\n",
        "            f\"\"\"Label: {plotcatalog.loc[i, 'Label']}\n",
        "            <br>Star Index: {i}\n",
        "            <br>X: {round(plotcatalog.loc[i, 'x_fit_med'],1)}\n",
        "            <br>Y: {round(plotcatalog.loc[i, 'y_fit_med'],1)}\n",
        "            <br>Distance: {round(plotcatalog.loc[i, 'distance'],1)}\"\"\"\n",
        "            for i in plotcatalog.index\n",
        "        ]\n",
        "\n",
        "    else:\n",
        "        hover_text = [\n",
        "            f\"\"\"Label: {plotcatalog.loc[i, 'Label']}\n",
        "            <br>Star Index: {i}\n",
        "            <br>X: {round(plotcatalog.loc[i, 'x'],1)}\n",
        "            <br>Y: {round(plotcatalog.loc[i, 'y'],1)}\n",
        "            <br>Distance: {round(plotcatalog.loc[i, 'distance'],1)}\"\"\"\n",
        "            for i in plotcatalog.index\n",
        "        ]\n",
        "\n",
        "    color_setting = plotcatalog['color']\n",
        "    size_setting = plotcatalog['size']\n",
        "    symbol_setting = plotcatalog['marker']\n",
        "    border_color = 'white' #plotcatalog['bordercolor']\n",
        "\n",
        "    marker_dict = dict(symbol=symbol_setting,\n",
        "                   line=dict(width=1,color=border_color),\n",
        "                   size=size_setting,\n",
        "                   color=color_setting,\n",
        "                   # colorscale=colorscale_setting,\n",
        "                   # colorbar=cbar_setting\n",
        "                  )\n",
        "\n",
        "    # Optical\n",
        "    fig.add_trace(\n",
        "        go.Scattergl(x=plotcatalog['F336W']-plotcatalog['F438W'],\n",
        "                     y=plotcatalog['F438W'],\n",
        "                     showlegend=False,mode='markers',\n",
        "                   marker=marker_dict,\n",
        "                   text=hover_text),\n",
        "        row=(ix%3+1), col=1\n",
        "    )\n",
        "\n",
        "    fig.add_trace(\n",
        "        go.Scattergl(x=plotcatalog['F438W']-plotcatalog['F547M'],\n",
        "                     y=plotcatalog['F547M'],\n",
        "                     showlegend=False,mode='markers',\n",
        "                   marker=marker_dict,\n",
        "                   text=hover_text),\n",
        "        row=(ix%3+1), col=2\n",
        "    )\n",
        "\n",
        "\n",
        "    fig.add_trace(\n",
        "        go.Scattergl(x=plotcatalog['F547M'] - plotcatalog['F814W'],\n",
        "                     y=plotcatalog['F814W'],\n",
        "                     showlegend=False, mode='markers',\n",
        "                   marker=marker_dict,\n",
        "                   text=hover_text),\n",
        "        row=(ix%3+1), col=3\n",
        "    )\n",
        "\n",
        "add_symbol_legend(fig)\n",
        "\n",
        "x_labels = ['F336W - F438W','F438W - F547M','F547M - F814W']\n",
        "y_labels = ['F438W','F547M','F814W']\n",
        "\n",
        "xrange1 = [-3.0, 3.05]\n",
        "xrange2 = [-2.25, 2.5]\n",
        "xrange3 = [-1.5,3.25]\n",
        "\n",
        "yrange1 = [26.75, 15.75]\n",
        "yrange2 = yrange1 #[-1.75, 2.75]\n",
        "yrange3 = yrange1#[-3., 2.]\n",
        "\n",
        "for col in [1,2,3]:\n",
        "    for row in [1,2,3]:\n",
        "        fig.update_xaxes(title_text=x_labels[(col-1)], row=row, col=col)\n",
        "        fig.update_xaxes(range=xrange1, row=row, col=1)\n",
        "        fig.update_xaxes(range=xrange2, row=row, col=2)\n",
        "        fig.update_xaxes(range=xrange3, row=row, col=3)\n",
        "        fig.update_yaxes(range=yrange1, row=row, col=1)\n",
        "        fig.update_yaxes(range=yrange2, row=row, col=2)\n",
        "        fig.update_yaxes(range=yrange3, row=row, col=3)\n",
        "        fig.update_yaxes(title_text=y_labels[(col-1)], row=row, col=col)\n",
        "\n",
        "axis_dict = dict(showgrid=False,zeroline=True,linecolor='black', linewidth=3.)\n",
        "\n",
        "fig.update_layout(plot_bgcolor='white',\n",
        "                  xaxis1=axis_dict,\n",
        "                  xaxis2=axis_dict,\n",
        "                  xaxis3=axis_dict,\n",
        "                  xaxis4=axis_dict,\n",
        "                  xaxis5=axis_dict,\n",
        "                  xaxis6=axis_dict,\n",
        "                  xaxis7=axis_dict,\n",
        "                  xaxis8=axis_dict,\n",
        "                  xaxis9=axis_dict,\n",
        "                  yaxis1=axis_dict,\n",
        "                  yaxis2=axis_dict,\n",
        "                  yaxis3=axis_dict,\n",
        "                  yaxis4=axis_dict,\n",
        "                  yaxis5=axis_dict,\n",
        "                  yaxis6=axis_dict,\n",
        "                  yaxis7=axis_dict,\n",
        "                  yaxis8=axis_dict,\n",
        "                  yaxis9=axis_dict\n",
        "                 )\n",
        "fig.update_layout(legend= {'itemsizing': 'constant'})\n",
        "fig.update_layout(font_size=20, height=1600, width=1350,\n",
        "                 legend=dict(orientation=\"v\",yanchor=\"top\",y=0.99,xanchor=\"right\",x=1.,xref='container'))\n",
        "fig.update_annotations(font_size=30,font=dict(weight=\"bold\"))\n",
        "fig.show()#renderer='browser')\n",
        "\n",
        "if os.getcwd() != final_path:\n",
        "    os.chdir(final_path)\n",
        "\n",
        "# fig.write_html(\"KnotA_Opt_CMD.html\")"
      ]
    },
