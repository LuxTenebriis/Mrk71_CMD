        "## Plotting functions\n",
        "\n",
        "# Add symbols to CMD legend for stellar populations\n",
        "# Surprisingly the quickest way to do it given current Plotly version\n",
        "\n",
        "def add_symbol_legend(fig,\n",
        "                      label1='MS',\n",
        "                      label2='RSG',\n",
        "                      label3='Y/R',\n",
        "                      sym1='circle',\n",
        "                      sym2='square',\n",
        "                      sym3='triangle-up',\n",
        "                      color1='blue',\n",
        "                      color2='black',\n",
        "                      color3='black',\n",
        "                      **kwargs):\n",
        "    # Add legend for symbols (not done automatically in Plotly when there's\n",
        "    # also a color legend)\n",
        "\n",
        "    fig.add_trace(go.Scatter(y=[None], mode='markers',\n",
        "                             marker=dict(symbol=sym1,color=color1),\n",
        "                             name=label1, legendgroup=\"group\",\n",
        "                             legendgrouptitle_text=\"\",\n",
        "                             ))\n",
        "\n",
        "    fig.add_trace(go.Scatter(y=[None], mode='markers',legendgroup=\"group\",\n",
        "                             marker=dict(symbol=sym2,color=color2),\n",
        "                             name=label2))\n",
        "\n",
        "    fig.add_trace(go.Scatter(y=[None], mode='markers',legendgroup=\"group\",\n",
        "                             marker=dict(symbol=sym3,color=color3),\n",
        "                             name=label3))\n",
        "    # fig.add_trace(go.Scatter(y=[None], mode='markers',legendgroup=\"group\",\n",
        "    #                          marker=dict(symbol=sym4,color=color4),\n",
        "    #                          name=label4))\n",
        "\n",
        "    # fig.update_layout(legend2=dict(title=dict(text = 'Stars')),**kwargs)\n",
        "\n",
        "    return None\n",
        "\n",
        "# Get TLUSTY-IndoUS isochrones\n",
        "def load_tlusty_isos(ages=['4','6','10','20','40','50','100']):\n",
        "    if os.getcwd() != tindo_path:\n",
        "        os.chdir(tindo_path)\n",
        "\n",
        "    isos = []\n",
        "\n",
        "    for age in ages:\n",
        "        iso = pd.read_csv(f'tindo_{age}Myr_STandVega.csv')\n",
        "        isos.append(iso)\n",
        "\n",
        "    return isos\n",
        "\n",
        "# Add isochrones to standard optical CMD set\n",
        "# \"dash\" = dashboard, AKA the interactive CMD sets\n",
        "def plot_tlusty_isos_cmd_optical_dash(fig, isos=None, ages = ['4','6','10','20','40','50','100'],\n",
        "                                      colors = ['blue', 'magenta', 'green','goldenrod','purple',\n",
        "                                                'orange','teal'],legend_title=\"T-Indo Isochrones\"):\n",
        "\n",
        "    if isos==None:\n",
        "        isos = load_tlusty_isos(ages)\n",
        "\n",
        "    for row_num in [1,2,3]:\n",
        "        for ii, isochrone in enumerate(isos):\n",
        "            fig.add_trace(go.Scatter(x=isochrone['U_vega']-isochrone['B_vega'], y=isochrone['B_vega'],\n",
        "                                     name=f\"{ages[ii]} Myr\",\n",
        "                                     mode='lines', legendgroup=str(ages[ii]),\n",
        "                                     line=dict(width=2, color=colors[ii]),\n",
        "                                     showlegend=(row_num==1)\n",
        "                                     ), row=row_num, col=1)\n",
        "\n",
        "            fig.add_trace(go.Scatter(x=isochrone['B_vega']-isochrone['V_vega'], y=isochrone['V_vega'],\n",
        "                                     name=f\"{ages[ii]} Myr\",\n",
        "                                     mode='lines', legendgroup=str(ages[ii]),\n",
        "                                     line=dict(width=2, color=colors[ii]),\n",
        "                                     showlegend=False\n",
        "                                     ), row=row_num, col=2)\n",
        "\n",
        "            fig.add_trace(go.Scatter(x=isochrone['V_vega']-isochrone['I_vega'], y=isochrone['I_vega'],\n",
        "                                     name=f\"{ages[ii]} Myr\",\n",
        "                                     mode='lines', legendgroup=str(ages[ii]),\n",
        "                                     line=dict(width=2, color=colors[ii]),\n",
        "                                     showlegend=False\n",
        "                                     ), row=row_num, col=3)\n",
        "    fig.update_layout(legend=dict(title=dict(text = legend_title)))\n",
        "\n",
        "    return fig\n",
        "\n",
        "# Add T-IndoUS isos to FUV/optical CMDs\n",
        "def plot_tlusty_isos_ccd_optfuv_dash(fig, isos=None, ages = ['4','6','10','20','40','50','100'],\n",
        "                                      colors = ['blue', 'magenta', 'green','goldenrod','purple',\n",
        "                                                'orange','teal'],legend_title=''):#T-Indo Isochrones'):\n",
        "\n",
        "    if isos==None:\n",
        "        isos = load_tlusty_isos(ages)\n",
        "\n",
        "    for row_num in [1,2,3]:\n",
        "        for ii, isochrone in enumerate(isos):\n",
        "            fig.add_trace(go.Scatter(x=isochrone['V_vega']-isochrone['I_vega'],\n",
        "                                     y=isochrone['U_vega']-isochrone['B_vega'],\n",
        "                                     name=f\"{ages[ii]} Myr\",\n",
        "                                     mode='lines', legendgroup=str(ages[ii]),\n",
        "                                     line=dict(width=2, color=colors[ii]),\n",
        "                                     showlegend=(row_num==1)\n",
        "                                     ), row=row_num, col=1)\n",
        "\n",
        "            fig.add_trace(go.Scatter(x=isochrone['V_vega']-isochrone['I_vega'],\n",
        "                                     y=isochrone['B_vega']-isochrone['V_vega'],\n",
        "                                     name=f\"{ages[ii]} Myr\",\n",
        "                                     mode='lines', legendgroup=str(ages[ii]),\n",
        "                                     line=dict(width=2, color=colors[ii]),\n",
        "                                     showlegend=False\n",
        "                                     ), row=row_num, col=2)\n",
        "\n",
        "            fig.add_trace(go.Scatter(x=isochrone['V_vega']-isochrone['I_vega'],\n",
        "                                     y=isochrone['FUV150_vega']-isochrone['U_vega'],\n",
        "                                     name=f\"{ages[ii]} Myr\",\n",
        "                                     mode='lines', legendgroup=str(ages[ii]),\n",
        "                                     line=dict(width=2, color=colors[ii]),\n",
        "                                     showlegend=False\n",
        "                                     ), row=row_num, col=3)\n",
        "    fig.update_layout(legend=dict(title=dict(text = legend_title)))\n",
        "\n",
        "    return fig"
      ]
